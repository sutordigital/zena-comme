    "faq_section": {
      "type": "collapsible-content",
      "settings": {
        "title": "A Few Things You Might Be Wondering"
      },
      "blocks": {
        "faq_1": { "type": "collapsible-row", "settings": { "heading": "Does the shirt completely repel pet hair?", "content": "<p>No. The fabric is smoother and more hair-resistant by construction, and smooth surfaces tend to release hair more easily. Results vary.</p>" } },
        "faq_2": { "type": "collapsible-row", "settings": { "heading": "How is it different from an ordinary custom tee?", "content": "<p>Most custom tees focus on the print. Ours starts with the fabric and fit, then adds the print.</p>" } },
        "faq_3": { "type": "collapsible-row", "settings": { "heading": "What kind of photo should I upload?", "content": "<p>A clear, well-lit photo with your pet's face and eyes visible works best.</p>" } },
        "faq_4": { "type": "collapsible-row", "settings": { "heading": "Can I preview my design before ordering?", "content": "<p>Yes, you'll see a preview of your personalized tee before checkout.</p>" } }
