    "hero_main": {
      "type": "hero",
      "settings": {
        "heading": "Finally, a Custom Pet Tee Made for Life With Your Pet.",
        "text": "<p>Because loving your pet shouldn't mean wearing their fur everywhere.</p><p>Turn your favorite photo into a tee you'll actually want to wear. Designed with premium pet-parent fabric, printed in full detail, and made to help reduce fur cling.</p><ul><li>✓ Helps keep fur off most everyday surfaces</li><li>✓ Made with premium soft cotton blend</li><li>✓ Made with your own pet photo</li><li>✓ Soft, smooth & breathable fabric</li></ul><p><strong>Zena Comme Personalized Pet Portrait Tee</strong><br>From $49.00 USD</p>",
        "button_label": "Create Your Custom Tee",
        "button_link": "shopify://products/your-product-handle",
        "image": "shopify://shop_images/zena-hero-main.jpg",
        "image_position": "right",
        "layout": "split"
      }
    },
