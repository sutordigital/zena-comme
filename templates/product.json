                  "blocks": {
                    "content": {
                      "type": "text",
                      "settings": {
                        "text": "<p>The fabric is described by our supplier as anti-static, moisture-wicking, cooling and hair-repellent.</p><p>These features are intended for everyday wear with pets. Hair-repellent does not mean fur-proof; performance can vary with use and care.</p>",
                        "width": "100%",
