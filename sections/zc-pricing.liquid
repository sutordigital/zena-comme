{% comment %} Zena Comme — Pricing cards {% endcomment %}

<section class="zc-pricing" id="zc-pricing-{{ section.id }}" style="--zc-bg: {{ section.settings.bg_color }}; --zc-pad-top: {{ section.settings.padding_top }}px; --zc-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="zc-pricing__inner">
    <div class="zc-pricing__header">
      {% if section.settings.eyebrow != blank %}<p class="zc-kicker">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="zc-pricing__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.subheading != blank %}<p class="zc-pricing__sub">{{ section.settings.subheading | escape }}</p>{% endif %}
    </div>
    <div class="zc-pricing__grid">
      {% for block in section.blocks %}
        <article class="zc-pricing__card{% if block.settings.featured %} zc-pricing__card--featured{% endif %}" {{ block.shopify_attributes }}>
          <p class="zc-pricing__badge{% if block.settings.badge == blank %} zc-pricing__badge--empty{% endif %}">
            {% if block.settings.badge != blank %}{{ block.settings.badge | escape }}{% else %}&nbsp;{% endif %}
          </p>
          <h3 class="zc-pricing__title">{{ block.settings.title | escape }}</h3>
          <p class="zc-pricing__price">{{ block.settings.price | escape }}</p>
          {% if block.settings.features != blank %}
            <ul class="zc-pricing__list">
              {% assign lines = block.settings.features | newline_to_br | split: '<br />' %}
              {% for line in lines %}
                {% assign t = line | strip %}
                {% if t != blank %}<li>{{ t | escape }}</li>{% endif %}
              {% endfor %}
            </ul>
          {% else %}
            <ul class="zc-pricing__list" aria-hidden="true"></ul>
          {% endif %}
          {% if block.settings.button_label != blank %}
            <a class="zc-btn zc-pricing__btn{% unless block.settings.featured %} zc-btn--outline{% endunless %}" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label | escape }}</a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .zc-pricing {
    background: var(--zc-bg, #f5f0e8);
    padding: var(--zc-pad-top, 64px) 1.25rem var(--zc-pad-bottom, 64px);
  }
  .zc-pricing__inner { max-width: 1100px; margin: 0 auto; }
  .zc-pricing__header { text-align: center; margin-bottom: 2rem; }
  .zc-pricing__heading {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    color: #1c1917;
  }
  .zc-pricing__sub { margin: 0; color: #57534e; }
  .zc-pricing__grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 800px) {
    .zc-pricing__grid { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; align-items: stretch; }
  }
  .zc-pricing__card {
    background: #fff;
    border: 1px solid #e7e0d6;
    border-radius: 16px;
    padding: 1.5rem 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
  }
  .zc-pricing__card--featured {
    border-color: #1c1917;
    border-width: 2px;
    box-shadow: 0 10px 28px rgba(28, 25, 23, 0.08);
  }
  .zc-pricing__badge {
    margin: 0 0 0.5rem;
    min-height: 1.1rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8b6b4a;
    font-weight: 600;
  }
  .zc-pricing__badge--empty { visibility: hidden; }
  .zc-pricing__title {
    margin: 0 0 0.35rem;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #44403c;
  }
  .zc-pricing__price {
    margin: 0 0 1rem;
    font-size: 2rem;
    font-weight: 700;
    color: #1c1917;
  }
  .zc-pricing__list {
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    flex: 1 1 auto;
  }
  .zc-pricing__list li {
    position: relative;
    padding-left: 1.1rem;
    margin: 0.4rem 0;
    color: #57534e;
    font-size: 0.92rem;
  }
  .zc-pricing__list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: #8b6b4a;
  }
  .zc-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    margin-top: auto;
    padding: 0.85rem 1.25rem;
    border-radius: 999px;
    background: #1c1917;
    color: #fff !important;
    text-decoration: none !important;
    font-weight: 600;
    font-size: 0.95rem;
    box-sizing: border-box;
  }
  .zc-pricing__btn { margin-top: auto; }
  .zc-btn--outline {
    background: transparent;
    color: #1c1917 !important;
    border: 1.5px solid #1c1917;
  }
  .zc-kicker {
    margin: 0 0 0.6rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8b6b4a;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ZC Pricing",
  "tag": "section",
  "class": "zc-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5F0E8" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PRICING & BUNDLES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One for You. One for Someone Who Loves Them Just as Much." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "One very spoilt pet. Two very proud pet parents." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "text", "id": "title", "label": "Title", "default": "The Personalized Tee" },
        { "type": "text", "id": "price", "label": "Price", "default": "$49" },
        { "type": "textarea", "id": "features", "label": "Features (one per line)", "default": "One pet portrait tee\nChoose black or white\nFront or back print" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Create My Tee" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "checkbox", "id": "featured", "label": "Featured plan", "default": false }
      ]
    }
  ],
  "presets": [{
    "name": "ZC Pricing",
    "blocks": [
      { "type": "plan", "settings": { "title": "The Personalized Tee", "price": "$49", "features": "One pet portrait tee\nChoose black or white\nFront or back print", "button_label": "Create My Tee" } },
      { "type": "plan", "settings": { "badge": "Preferential offer", "title": "Pet Parent Set", "price": "$89", "features": "Two personalized tees\nChoose the color and size of each\nSave $9 vs. two singles", "button_label": "Create Our Set", "featured": true } },
      { "type": "plan", "settings": { "badge": "Optional", "title": "Gift-Ready Upgrade", "price": "+$5", "features": "A little extra care for birthdays and special moments.", "button_label": "Add to Order" } }
    ]
  }]
}
{% endschema %}
