{% comment %} Zena Comme — 3 benefit cards {% endcomment %}

<section class="zc-benefits" id="zc-benefits-{{ section.id }}" style="--zc-bg: {{ section.settings.bg_color }}; --zc-pad-top: {{ section.settings.padding_top }}px; --zc-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="zc-benefits__inner">
    <div class="zc-benefits__header">
      {% if section.settings.eyebrow != blank %}<p class="zc-kicker">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="zc-benefits__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.subheading != blank %}<p class="zc-benefits__sub">{{ section.settings.subheading | escape }}</p>{% endif %}
    </div>
    <div class="zc-benefits__grid">
      {% for block in section.blocks %}
        <article class="zc-benefits__card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'zc-benefits__img', alt: block.settings.image.alt | default: block.settings.title }}
          {% else %}
            <div class="zc-benefits__ph" aria-hidden="true">
              <span>Add card image</span>
            </div>
          {% endif %}
          {% if block.settings.title != blank %}<h3 class="zc-benefits__title">{{ block.settings.title | escape }}</h3>{% endif %}
          {% if block.settings.text != blank %}<p class="zc-benefits__text">{{ block.settings.text | escape }}</p>{% endif %}
        </article>
      {% endfor %}
    </div>
    {% if section.settings.button_label != blank %}
      <div class="zc-benefits__cta">
        <a class="zc-btn zc-btn--inline" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .zc-benefits {
    background: var(--zc-bg, #f5f0e8);
    padding: var(--zc-pad-top, 80px) 1.25rem var(--zc-pad-bottom, 80px);
  }
  .zc-benefits__inner { max-width: 1100px; margin: 0 auto; }
  .zc-benefits__header { text-align: center; margin-bottom: 2rem; }
  .zc-kicker {
    margin: 0 0 0.6rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8b6b4a;
  }
  .zc-benefits__heading {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    color: #1c1917;
  }
  .zc-benefits__sub { margin: 0; color: #57534e; }
  .zc-benefits__grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 750px) {
    .zc-benefits__grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  }
  .zc-benefits__card {
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 4px 18px rgba(40, 30, 20, 0.05);
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .zc-benefits__img, .zc-benefits__ph {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    flex: 0 0 auto;
  }
  .zc-benefits__ph {
    background: #e8e0d4;
    display: grid;
    place-items: center;
    color: #8a8076;
    font-size: 0.85rem;
  }
  .zc-benefits__title {
    margin: 1rem 1.1rem 0.35rem;
    font-size: 1.1rem;
    color: #1c1917;
  }
  .zc-benefits__text {
    margin: 0 1.1rem 1.25rem;
    color: #57534e;
    font-size: 0.95rem;
    line-height: 1.5;
    flex: 1;
  }
  .zc-benefits__cta { text-align: center; margin-top: 2rem; }
  .zc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    background: #1c1917;
    color: #fff !important;
    text-decoration: none !important;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .zc-btn--inline { width: auto; min-width: 220px; padding-inline: 1.75rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "ZC Benefits",
  "tag": "section",
  "class": "zc-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5F0E8" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE TRANSFORMED EVERYDAY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More Cuddles. Less Fur Drama." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "You're going to cuddle them anyway. You deserve a tee that gets it." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Create Your Everyday Pet Tee" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Benefit card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Cuddle Freely" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Make room for the moments that matter." }
      ]
    }
  ],
  "presets": [{
    "name": "ZC Benefits",
    "blocks": [
      { "type": "card", "settings": { "title": "Cuddle Freely", "text": "Make room for the moments that matter." } },
      { "type": "card", "settings": { "title": "Brush Off Easier", "text": "A smoother surface designed to make loose fur less clingy." } },
      { "type": "card", "settings": { "title": "Wear It Everywhere", "text": "From couch cuddles to coffee runs." } }
    ]
  }]
}
{% endschema %}
