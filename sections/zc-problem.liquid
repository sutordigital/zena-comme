{% comment %} Zena Comme — Problem section (collage + copy) {% endcomment %}

<section class="zc-problem" id="zc-problem-{{ section.id }}" style="--zc-bg: {{ section.settings.bg_color }}; --zc-pad-top: {{ section.settings.padding_top }}px; --zc-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="zc-problem__inner">
    <div class="zc-problem__media">
      {% if section.settings.image_1 != blank %}
        {{
          section.settings.image_1
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            class: 'zc-problem__img',
            widths: '480, 720, 960, 1200, 1400',
            sizes: '(min-width: 900px) 584px, calc(100vw - 40px)',
            alt: section.settings.image_1.alt | default: section.settings.heading
        }}
      {% else %}
        <div class="zc-problem__ph">Add image in Theme Editor</div>
      {% endif %}
    </div>
    <div class="zc-problem__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="zc-kicker">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="zc-problem__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="zc-problem__body">{{ section.settings.body }}</div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .zc-problem {
    background: var(--zc-bg, #faf7f2);
    padding: var(--zc-pad-top, 64px) 1.25rem var(--zc-pad-bottom, 64px);
  }
  .zc-problem__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .zc-problem__inner {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      align-items: center;
    }
  }
  .zc-problem__media {
    width: 100%;
    overflow: hidden;
    border-radius: 12px;
    background: #e8e0d4;
    aspect-ratio: 4 / 3;
  }
  .zc-problem__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .zc-problem__ph {
    min-height: 280px;
    height: 100%;
    display: grid;
    place-items: center;
    color: #7a6f63;
    background: #e8e0d4;
    font-size: 0.85rem;
  }
  .zc-kicker {
    margin: 0 0 0.75rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8b6b4a;
  }
  .zc-problem__heading {
    margin: 0 0 1rem;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    line-height: 1.2;
    color: #1c1917;
  }
  .zc-problem__body {
    color: #44403c;
    font-size: 16px;
    line-height: 26px;
  }
  .zc-problem__body p { margin: 0 0 0.9rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "ZC Problem",
  "tag": "section",
  "class": "zc-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FAF7F2" },
    { "type": "image_picker", "id": "image_1", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE PET PARENT PROBLEM" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You Love Your Pet. The Fur on Your Clothes? Not So Much." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>You put on a clean black tee. Your dog gives you that look. You lean in for one little nuzzle. And suddenly you're reaching for the lint roller. Again.</p><p><em>What if your favorite pet tee was made with those moments in mind?</em></p>" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "presets": [{ "name": "ZC Problem" }]
}
{% endschema %}
