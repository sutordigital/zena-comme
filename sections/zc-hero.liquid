{% comment %}
  Zena Comme — Split hero (collage + product CTA card)
{% endcomment %}

<section class="zc-hero" id="zc-hero-{{ section.id }}" style="--zc-bg: {{ section.settings.bg_color }}; --zc-pad-top: {{ section.settings.padding_top }}px; --zc-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="zc-hero__inner">
    <div class="zc-hero__media">
      {% if section.settings.image_main != blank %}
        {{ section.settings.image_main | image_url: width: 1600 | image_tag: loading: 'eager', class: 'zc-hero__img zc-hero__img--main', alt: section.settings.image_main.alt | default: section.settings.heading }}
      {% else %}
        <div class="zc-hero__placeholder">Add main lifestyle image</div>
      {% endif %}
      <div class="zc-hero__thumbs">
        {% for i in (1..3) %}
          {% assign key = 'image_thumb_' | append: i %}
          {% assign img = section.settings[key] %}
          {% if img != blank %}
            {{ img | image_url: width: 600 | image_tag: loading: 'lazy', class: 'zc-hero__img', alt: img.alt }}
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="zc-hero__card">
      {% if section.settings.eyebrow != blank %}
        <p class="zc-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h1 class="zc-hero__heading">{{ section.settings.heading | escape }}</h1>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="zc-hero__body">{{ section.settings.body }}</div>
      {% endif %}
      {% if section.settings.bullets != blank %}
        <ul class="zc-hero__bullets">
          {% assign lines = section.settings.bullets | newline_to_br | split: '<br />' %}
          {% for line in lines %}
            {% assign t = line | strip %}
            {% if t != blank %}
              <li>{{ t | escape }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
      {% if section.settings.price_label != blank %}
        <p class="zc-hero__price">
          <span class="zc-hero__price-name">{{ section.settings.price_label | escape }}</span>
          {% if section.settings.price != blank %}
            <span class="zc-hero__price-value">From {{ section.settings.price | escape }}</span>
          {% endif %}
        </p>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="zc-btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
      {% endif %}
      {% if section.settings.microcopy != blank %}
        <p class="zc-hero__micro">{{ section.settings.microcopy | escape }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .zc-hero {
    background: var(--zc-bg, #f5f0e8);
    padding: var(--zc-pad-top, 40px) 1.25rem var(--zc-pad-bottom, 40px);
  }
  .zc-hero__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .zc-hero__inner {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 2.5rem;
    }
  }
  .zc-hero__media {
    display: grid;
    gap: 0.75rem;
  }
  .zc-hero__img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
    object-fit: cover;
  }
  .zc-hero__img--main {
    aspect-ratio: 4 / 5;
  }
  .zc-hero__thumbs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  .zc-hero__thumbs .zc-hero__img {
    aspect-ratio: 1;
  }
  .zc-hero__placeholder {
    aspect-ratio: 4 / 5;
    border-radius: 12px;
    background: #e8e0d4;
    display: grid;
    place-items: center;
    color: #7a6f63;
    font-size: 0.9rem;
  }
  .zc-hero__card {
    background: #fff;
    border-radius: 16px;
    padding: 1.75rem 1.5rem;
    box-shadow: 0 8px 30px rgba(40, 30, 20, 0.06);
  }
  .zc-hero__eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8b6b4a;
  }
  .zc-hero__heading {
    margin: 0 0 1rem;
    font-size: clamp(1.6rem, 2.4vw, 2.15rem);
    line-height: 1.15;
    color: #1c1917;
  }
  .zc-hero__body {
    color: #44403c;
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .zc-hero__body p { margin: 0 0 0.75rem; }
  .zc-hero__bullets {
    margin: 1rem 0;
    padding: 0;
    list-style: none;
  }
  .zc-hero__bullets li {
    position: relative;
    padding-left: 1.25rem;
    margin: 0.35rem 0;
    color: #44403c;
    font-size: 0.95rem;
  }
  .zc-hero__bullets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #8b6b4a;
    font-weight: 600;
  }
  .zc-hero__price {
    margin: 1.25rem 0;
    padding-top: 1rem;
    border-top: 1px solid #ece7df;
  }
  .zc-hero__price-name {
    display: block;
    font-weight: 600;
    color: #1c1917;
    margin-bottom: 0.25rem;
  }
  .zc-hero__price-value {
    font-size: 1.15rem;
    color: #1c1917;
  }
  .zc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    padding: 0.85rem 1.25rem;
    border-radius: 999px;
    background: #1c1917;
    color: #fff !important;
    text-decoration: none !important;
    font-weight: 600;
    font-size: 0.95rem;
    transition: opacity 0.15s ease;
  }
  .zc-btn:hover { opacity: 0.88; }
  .zc-hero__micro {
    margin: 0.85rem 0 0;
    text-align: center;
    font-size: 0.8rem;
    color: #78716c;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ZC Hero",
  "tag": "section",
  "class": "zc-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5F0E8" },
    { "type": "image_picker", "id": "image_main", "label": "Main lifestyle image" },
    { "type": "image_picker", "id": "image_thumb_1", "label": "Thumbnail 1" },
    { "type": "image_picker", "id": "image_thumb_2", "label": "Thumbnail 2" },
    { "type": "image_picker", "id": "image_thumb_3", "label": "Thumbnail 3" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PERSONALIZED PET TEE · PET-HAIR-RESISTANT FABRIC" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Finally, a Custom Pet Tee Made for Life With Your Pet." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Because loving your pet shouldn't mean wearing their fur everywhere.</p>" },
    { "type": "textarea", "id": "bullets", "label": "Bullets (one per line)", "default": "Helps loose fur brush off more easily\nMade personal with your own pet photo\nEveryday style in black or white" },
    { "type": "text", "id": "price_label", "label": "Product name", "default": "Zena Comme Personalized Pet Portrait Tee" },
    { "type": "text", "id": "price", "label": "From price", "default": "$49.00" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Create My Custom Tee" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "microcopy", "label": "Microcopy", "default": "Made to order · Free shipping · Secure checkout" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 40 }
  ],
  "presets": [{ "name": "ZC Hero" }]
}
{% endschema %}
