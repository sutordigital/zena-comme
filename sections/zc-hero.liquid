{% comment %}
  Zena Comme — Split hero matching mockup:
  left collage (main + thumbs) | right product CTA card
{% endcomment %}

<section
  class="zc-hero"
  id="zc-hero-{{ section.id }}"
  style="
    --zc-bg: {{ section.settings.bg_color }};
    --zc-pad-top: {{ section.settings.padding_top }}px;
    --zc-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="zc-hero__inner">
    {%- assign has_thumbs = false -%}
    {%- for i in (1..6) -%}
      {%- assign key = 'image_thumb_' | append: i -%}
      {%- if section.settings[key] != blank -%}
        {%- assign has_thumbs = true -%}
      {%- endif -%}
    {%- endfor -%}

    <div class="zc-hero__media" data-zc-gallery>
      <div class="zc-hero__main-wrap">
        {% if section.settings.image_main != blank %}
          {{
            section.settings.image_main
            | image_url: width: 1800
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              class: 'zc-hero__img zc-hero__img--main',
              widths: '600,900,1200,1600',
              sizes: '(min-width: 990px) 55vw, 100vw',
              alt: section.settings.image_main.alt | default: section.settings.heading
          }}
        {% else %}
          <div class="zc-hero__placeholder zc-hero__placeholder--main">
            <span>Upload main product image</span>
          </div>
        {% endif %}

        {% if section.settings.image_main != blank and has_thumbs %}
          <button class="zc-hero__arrow zc-hero__arrow--prev" type="button" data-zc-gallery-prev aria-label="Previous image">
            <span aria-hidden="true">‹</span>
          </button>
          <button class="zc-hero__arrow zc-hero__arrow--next" type="button" data-zc-gallery-next aria-label="Next image">
            <span aria-hidden="true">›</span>
          </button>
        {% endif %}
      </div>

      <div class="zc-hero__thumbs{% unless has_thumbs %} zc-hero__thumbs--empty{% endunless %}" aria-label="Product gallery thumbnails">
        {% for i in (1..6) %}
          {% assign key = 'image_thumb_' | append: i %}
          {% assign img = section.settings[key] %}
          {% if img != blank %}
            <button
              class="zc-hero__thumb"
              type="button"
              data-zc-gallery-thumb
              data-gallery-src="{{ img | image_url: width: 1800 }}"
              data-gallery-srcset="{{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1600 }} 1600w"
              data-gallery-alt="{{ img.alt | default: section.settings.heading | escape }}"
              aria-label="View image {{ i | plus: 1 }}"
            >
              {{
                img
                | image_url: width: 500
                | image_tag:
                  loading: 'lazy',
                  class: 'zc-hero__img zc-hero__img--thumb',
                  widths: '160,240,360,500',
                  sizes: '(min-width: 750px) 9vw, 80px',
                  alt: img.alt | default: section.settings.heading
              }}
            </button>
          {% else %}
            <div class="zc-hero__thumb zc-hero__thumb--placeholder">
              <div class="zc-hero__placeholder zc-hero__placeholder--thumb">Image {{ i | plus: 1 }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {%- comment -%} RIGHT: product card {%- endcomment -%}
    <div class="zc-hero__card">
      {% if section.settings.eyebrow != blank %}
        <p class="zc-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="zc-hero__heading">{{ section.settings.heading | escape }}</h1>
      {% endif %}

      {% if section.settings.body != blank %}
        <div class="zc-hero__body rte">{{ section.settings.body }}</div>
      {% endif %}

      {% if section.settings.bullets != blank %}
        <ul class="zc-hero__bullets">
          {% assign lines = section.settings.bullets | newline_to_br | split: '<br />' %}
          {% for line in lines %}
            {% assign t = line | strip %}
            {% if t != blank %}
              <li>{{ t | escape }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}

      {% if section.settings.price_label != blank or section.settings.price != blank %}
        <div class="zc-hero__price">
          {% if section.settings.price_label != blank %}
            <p class="zc-hero__price-name">{{ section.settings.price_label | escape }}</p>
          {% endif %}
          {% if section.settings.price != blank %}
            <p class="zc-hero__price-value">From {{ section.settings.price | escape }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_option_hints %}
        <div class="zc-hero__hints">
          <div class="zc-hero__hint">
            <span class="zc-hero__hint-label">Choose your color</span>
            <span class="zc-hero__hint-value">Black · White</span>
          </div>
          <div class="zc-hero__hint">
            <span class="zc-hero__hint-label">Choose your size</span>
            <span class="zc-hero__hint-value">View size guide</span>
          </div>
          <div class="zc-hero__hint">
            <span class="zc-hero__hint-label">Print placement</span>
            <span class="zc-hero__hint-value">Front · Back</span>
          </div>
          <div class="zc-hero__hint">
            <span class="zc-hero__hint-label">Upload your pet photo</span>
            <span class="zc-hero__hint-value">On product page</span>
          </div>
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a class="zc-hero__btn" href="{{ section.settings.button_link | default: '#' }}">
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}

      {% if section.settings.microcopy != blank %}
        <p class="zc-hero__micro">{{ section.settings.microcopy | escape }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  /* Shell: full width, centers child — NEVER put grid columns here */
  .zc-hero {
    background: var(--zc-bg, #f5f0e8);
    padding: var(--zc-pad-top, 32px) clamp(1.25rem, 5vw, 4rem) var(--zc-pad-bottom, 48px);
    width: 100% !important;
    max-width: none !important;
    box-sizing: border-box;
    display: flex !important;
    justify-content: center !important;
    grid-template-columns: none !important;
  }

  /* Content row — only place for columns */
  .zc-hero__inner {
    width: 100%;
    max-width: 1200px;
    margin-left: auto !important;
    margin-right: auto !important;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    box-sizing: border-box;
  }

  @media screen and (min-width: 990px) {
    .zc-hero__inner {
      flex-direction: row;
      align-items: flex-start;
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }

    .zc-hero__media {
      flex: 1 1 55%;
      min-width: 0;
    }

    .zc-hero__card {
      flex: 0 0 min(420px, 40%);
      width: min(420px, 40%);
      align-self: flex-start;
      height: auto;
    }
  }

  /* —— Media column —— */
  .zc-hero__media {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .zc-hero__main-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
    background: #e8e0d4;
  }

  .zc-hero__img {
    width: 100%;
    height: auto;
    display: block;
  }

  .zc-hero__img--main {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    object-position: center;
    background: #e8e0d4;
  }

  .zc-hero__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 44px;
    height: 44px;
    padding: 0;
    display: grid;
    place-items: center;
    transform: translateY(-50%);
    border: 1px solid rgba(56, 43, 37, 0.14);
    border-radius: 50%;
    color: #382b25;
    background: rgba(247, 243, 236, 0.94);
    box-shadow: 0 4px 16px rgba(28, 25, 23, 0.12);
    cursor: pointer;
  }

  .zc-hero__arrow span {
    display: block;
    font-size: 2rem;
    line-height: 1;
    transform: translateY(-1px);
  }

  .zc-hero__arrow--prev {
    left: 1rem;
  }

  .zc-hero__arrow--next {
    right: 1rem;
  }

  .zc-hero__arrow:hover {
    background: #ffffff;
  }

  .zc-hero__arrow:focus-visible,
  .zc-hero__thumb:focus-visible {
    outline: 3px solid #c87546;
    outline-offset: 3px;
  }

  .zc-hero__thumbs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .zc-hero__thumb {
    width: 100%;
    min-width: 0;
    aspect-ratio: 1 / 1;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 10px;
    overflow: hidden;
    background: #e8e0d4;
    cursor: pointer;
  }

  .zc-hero__thumb.is-active {
    border-color: #382b25;
  }

  .zc-hero__thumb--placeholder {
    cursor: default;
  }

  .zc-hero__img--thumb {
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .zc-hero__thumbs {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 80px;
      gap: 0.55rem;
      overflow-x: auto;
      padding: 0.2rem 0.2rem 0.65rem;
      scroll-snap-type: x proximity;
      scrollbar-width: thin;
    }

    .zc-hero__thumb {
      scroll-snap-align: start;
    }

    .zc-hero__arrow {
      width: 42px;
      height: 42px;
    }

    .zc-hero__arrow--prev {
      left: 0.75rem;
    }

    .zc-hero__arrow--next {
      right: 0.75rem;
    }
  }

  .zc-hero__placeholder {
    display: grid;
    place-items: center;
    text-align: center;
    color: #8a8076;
    font-size: 0.9rem;
    line-height: 1.4;
    background: #e8e0d4;
  }

  .zc-hero__placeholder small {
    opacity: 0.8;
    font-size: 0.78rem;
  }

  .zc-hero__placeholder--main {
    width: 100%;
    height: 100%;
    min-height: 320px;
  }

  .zc-hero__placeholder--thumb {
    aspect-ratio: 1 / 1;
    font-size: 0.75rem;
  }

  /* —— Product card —— */
  .zc-hero__card {
    background: #ffffff;
    border-radius: 20px;
    padding: clamp(1.35rem, 2.5vw, 1.85rem);
    box-shadow:
      0 1px 2px rgba(28, 25, 23, 0.04),
      0 12px 40px rgba(28, 25, 23, 0.08);
    display: flex;
    flex-direction: column;
    height: auto;
    align-self: flex-start;
    box-sizing: border-box;
  }

  @media screen and (min-width: 990px) {
    .zc-hero__card {
      position: sticky;
      top: 1.25rem;
      height: auto;
      align-self: flex-start;
    }
  }

  .zc-hero__eyebrow {
    margin: 0 0 0.85rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8b6b4a;
    font-weight: 600;
    line-height: 1.4;
  }

  .zc-hero__heading {
    margin: 0 0 1rem;
    font-size: clamp(1.55rem, 2.2vw, 2.05rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #1c1917;
    font-weight: 500;
  }

  .zc-hero__body {
    color: #57534e;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .zc-hero__body p {
    margin: 0 0 0.65rem;
  }

  .zc-hero__body p:last-child {
    margin-bottom: 0;
  }

  .zc-hero__bullets {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .zc-hero__bullets li {
    position: relative;
    padding: 0.28rem 0 0.28rem 1.35rem;
    color: #44403c;
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .zc-hero__bullets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0.28rem;
    color: #8b6b4a;
    font-weight: 700;
  }

  .zc-hero__price {
    margin-top: 1.15rem;
    padding-top: 1rem;
    border-top: 1px solid #ece7df;
  }

  .zc-hero__price-name {
    margin: 0 0 0.2rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: #1c1917;
  }

  .zc-hero__price-value {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: #1c1917;
  }

  .zc-hero__hints {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .zc-hero__hint {
    border: 1px solid #e7e0d6;
    border-radius: 10px;
    padding: 0.55rem 0.65rem;
    background: #faf7f2;
  }

  .zc-hero__hint-label {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #8b6b4a;
    margin-bottom: 0.15rem;
  }

  .zc-hero__hint-value {
    display: block;
    font-size: 0.82rem;
    color: #1c1917;
    font-weight: 500;
  }

  .zc-hero__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 52px;
    margin-top: 1.15rem;
    padding: 0.9rem 1.25rem;
    border-radius: 999px;
    background: #1c1917;
    color: #fff !important;
    text-decoration: none !important;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    transition: opacity 0.15s ease;
  }

  .zc-hero__btn:hover {
    opacity: 0.9;
  }

  .zc-hero__micro {
    margin: 0.85rem 0 0;
    text-align: center;
    font-size: 0.78rem;
    color: #78716c;
    line-height: 1.4;
  }

  

  .zc-hero,
  .zc-problem,
  .zc-benefits,
  .zc-compare,
  .zc-features,
  .zc-split,
  .zc-steps,
  .zc-ctable,
  .zc-pricing,
  .zc-policy,
  .zc-faq,
  .zc-cta {
    padding: 80px 30px !important;
  }

  @media screen and (max-width: 749px) {
    .zc-hero,
    .zc-problem,
    .zc-benefits,
    .zc-compare,
    .zc-features,
    .zc-split,
    .zc-steps,
    .zc-ctable,
    .zc-pricing,
    .zc-policy,
    .zc-faq,
    .zc-cta {
      padding: 40px 20px !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  const initializeZcGallery = (gallery) => {
    if (!gallery || gallery.dataset.zcGalleryReady === 'true') return;

    const mainImage = gallery.querySelector('.zc-hero__img--main');
    const thumbnailButtons = Array.from(gallery.querySelectorAll('[data-zc-gallery-thumb]'));
    const previousButton = gallery.querySelector('[data-zc-gallery-prev]');
    const nextButton = gallery.querySelector('[data-zc-gallery-next]');

    if (!mainImage || thumbnailButtons.length === 0) return;

    const slides = [
      {
        src: mainImage.currentSrc || mainImage.src,
        srcset: mainImage.srcset,
        sizes: mainImage.sizes,
        alt: mainImage.alt
      },
      ...thumbnailButtons.map((button) => ({
        src: button.dataset.gallerySrc,
        srcset: button.dataset.gallerySrcset,
        sizes: '(min-width: 990px) 55vw, 100vw',
        alt: button.dataset.galleryAlt
      }))
    ];

    let activeIndex = 0;

    const showSlide = (requestedIndex) => {
      activeIndex = (requestedIndex + slides.length) % slides.length;
      const slide = slides[activeIndex];

      mainImage.src = slide.src;
      mainImage.srcset = slide.srcset || '';
      mainImage.sizes = slide.sizes || '';
      mainImage.alt = slide.alt || '';

      thumbnailButtons.forEach((button, index) => {
        const isActive = index + 1 === activeIndex;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
    };

    thumbnailButtons.forEach((button, index) => {
      button.addEventListener('click', () => showSlide(index + 1));
    });

    previousButton?.addEventListener('click', () => showSlide(activeIndex - 1));
    nextButton?.addEventListener('click', () => showSlide(activeIndex + 1));

    gallery.dataset.zcGalleryReady = 'true';
  };

  const initializeAllZcGalleries = (scope = document) => {
    scope.querySelectorAll('[data-zc-gallery]').forEach(initializeZcGallery);
  };

  initializeAllZcGalleries();

  document.addEventListener('shopify:section:load', (event) => {
    initializeAllZcGalleries(event.target);
  });
{% endjavascript %}

