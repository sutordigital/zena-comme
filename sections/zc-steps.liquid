{% comment %} ZC Steps — How it works {% endcomment %}
<section class="zc-steps" id="zc-steps-{{ section.id }}" style="--zc-bg: {{ section.settings.bg_color }}; --zc-pad-top: {{ section.settings.padding_top }}px; --zc-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="zc-steps__inner">
    <div class="zc-steps__header">
      {% if section.settings.eyebrow != blank %}<p class="zc-kicker">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="zc-steps__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.subheading != blank %}<p class="zc-steps__sub">{{ section.settings.subheading | escape }}</p>{% endif %}
    </div>
    <div class="zc-steps__grid">
      {% for block in section.blocks %}
        <article class="zc-steps__card" {{ block.shopify_attributes }}>
          <div class="zc-steps__num">{{ block.settings.number | default: forloop.index | escape }}</div>
          {% if block.settings.title != blank %}<h3 class="zc-steps__title">{{ block.settings.title | escape }}</h3>{% endif %}
          {% if block.settings.text != blank %}<p class="zc-steps__text">{{ block.settings.text | escape }}</p>{% endif %}
        </article>
      {% endfor %}
    </div>
    {% if section.settings.button_label != blank %}
      <div class="zc-steps__cta">
        <a class="zc-btn zc-btn--inline" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
      </div>
    {% endif %}
  </div>
</section>
{% stylesheet %}
  .zc-steps { background: var(--zc-bg, #faf7f2); padding: var(--zc-pad-top, 64px) 1.25rem var(--zc-pad-bottom, 64px); }
  .zc-steps__inner { max-width: 1000px; margin: 0 auto; }
  .zc-steps__header { text-align: center; margin-bottom: 2rem; }
  .zc-kicker { margin: 0 0 0.6rem; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: #8b6b4a; }
  .zc-steps__heading { margin: 0 0 0.5rem; font-size: clamp(1.45rem, 2.1vw, 1.9rem); color: #1c1917; }
  .zc-steps__sub { margin: 0; color: #57534e; }
  .zc-steps__grid { display: grid; gap: 1.25rem; }
  @media (min-width: 750px) { .zc-steps__grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; } }
  .zc-steps__card { text-align: center; padding: 0.5rem; }
  .zc-steps__num {
    width: 2.5rem; height: 2.5rem; margin: 0 auto 0.85rem; border-radius: 999px;
    background: #1c1917; color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 0.95rem;
  }
  .zc-steps__title { margin: 0 0 0.4rem; font-size: 1.1rem; color: #1c1917; }
  .zc-steps__text { margin: 0; color: #57534e; font-size: 0.95rem; line-height: 1.5; }
  .zc-steps__cta { text-align: center; margin-top: 2rem; }
  .zc-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0.85rem 1.5rem; border-radius: 999px; background: #1c1917; color: #fff !important; text-decoration: none !important; font-weight: 600; }
  .zc-btn--inline { width: auto; }
{% endstylesheet %}
{% schema %}
{
  "name": "ZC Steps",
  "tag": "section",
  "class": "zc-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FAF7F2" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW IT WORKS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Pet. Your Tee. Three Simple Steps." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "You don't need to be a designer. Just bring the pet photo you love." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start Creating My Tee" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [{
    "type": "step",
    "name": "Step",
    "settings": [
      { "type": "text", "id": "number", "label": "Number", "default": "1" },
      { "type": "text", "id": "title", "label": "Title", "default": "Make It Yours" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Choose your shirt color, size, and print placement." }
    ]
  }],
  "presets": [{
    "name": "ZC Steps",
    "blocks": [
      { "type": "step", "settings": { "number": "1", "title": "Make It Yours", "text": "Choose your shirt color, size, and print placement." } },
      { "type": "step", "settings": { "number": "2", "title": "Upload Your Favorite Pet Photo", "text": "Choose a clear photo and adjust the placement using the available preview tools." } },
      { "type": "step", "settings": { "number": "3", "title": "We'll Make Your Tee", "text": "Your personalized design is prepared for printing, then made to order and shipped to you." } }
    ]
  }]
}
{% endschema %}
