{% comment %} ZC CTA — bottom full-bleed {% endcomment %}
{% style %}
  #zc-cta-{{ section.id }} .zc-cta__eyebrow,
  #zc-cta-{{ section.id }} .zc-cta__heading,
  #zc-cta-{{ section.id }} .zc-cta__body,
  #zc-cta-{{ section.id }} .zc-cta__body p,
  #zc-cta-{{ section.id }} .zc-cta__micro {
    color: #ffffff !important;
  }
{% endstyle %}
<section class="zc-cta" id="zc-cta-{{ section.id }}" style="--zc-pad-top: {{ section.settings.padding_top }}px; --zc-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="zc-cta__bg{% if section.settings.image == blank %} zc-cta__bg--solid{% endif %}">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', class: 'zc-cta__img', alt: section.settings.heading }}
      <div class="zc-cta__overlay" style="--zc-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
    {% endif %}
  </div>
  <div class="zc-cta__content">
    {% if section.settings.eyebrow != blank %}<p class="zc-cta__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2 class="zc-cta__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.body != blank %}<div class="zc-cta__body">{{ section.settings.body }}</div>{% endif %}
    {% if section.settings.button_label != blank %}
      <a class="zc-btn zc-btn--light" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
    {% endif %}
    {% if section.settings.microcopy != blank %}<p class="zc-cta__micro">{{ section.settings.microcopy | escape }}</p>{% endif %}
  </div>
</section>
{% stylesheet %}
  .zc-cta { position: relative; padding: var(--zc-pad-top, 100px) 1.25rem var(--zc-pad-bottom, 100px); color: #fff; overflow: hidden; background: #1c1917; }
  .zc-cta__bg { position: absolute; inset: 0; }
  .zc-cta__bg--solid { background: #1c1917; }
  .zc-cta__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .zc-cta__overlay { position: absolute; inset: 0; background: rgba(0,0,0, var(--zc-overlay, 0.55)); }
  .zc-cta__content { position: relative; z-index: 1; max-width: 640px; margin: 0 auto; text-align: center; }
  .zc-cta__eyebrow { margin: 0 0 0.75rem; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.9; }
  .zc-cta__heading { margin: 0 0 1rem; font-size: clamp(1.6rem, 2.5vw, 2.2rem); line-height: 1.2; }
  .zc-cta__body { margin: 0 0 1.5rem; line-height: 1.55; opacity: 0.92; }
  .zc-cta__body p { margin: 0 0 0.75rem; }
  /* P0: beat other sections' .zc-btn { background:#1c1917 } (black-on-black) */
  .zc-cta a.zc-btn.zc-btn--light {
    background: #fff !important;
    color: #1c1917 !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    text-decoration: none !important;
    font-weight: 600;
    border: none;
  }
  .zc-cta a.zc-btn.zc-btn--light:hover { opacity: 0.92; }
  .zc-cta__micro { margin: 1rem 0 0; font-size: 0.85rem; opacity: 0.85; }
{% endstylesheet %}
{% schema %}
{
  "name": "ZC CTA",
  "tag": "section",
  "class": "zc-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "overlay_opacity", "min": 20, "max": 90, "step": 5, "unit": "%", "label": "Overlay darkness", "default": 55 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "YOUR PET. YOUR PORTRAIT." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "They're More Than a Pet. They're Part of Your Everyday." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>A personalized tee designed to celebrate the face you love—with less fur-cling fuss.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Create My Custom Tee" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "microcopy", "label": "Microcopy", "default": "Your pet. Your portrait. Your new everyday favorite." },
    { "type": "range", "id": "padding_top", "min": 40, "max": 160, "step": 4, "unit": "px", "label": "Padding top", "default": 100 },
    { "type": "range", "id": "padding_bottom", "min": 40, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom", "default": 100 }
  ],
  "presets": [{ "name": "ZC CTA" }]
}
{% endschema %}
