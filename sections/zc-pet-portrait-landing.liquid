          "blocks": {
            "row_1": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Does the shirt completely repel pet hair?",
                "open_by_default": false
              },
              "blocks": {
                "text_1": {
                  "type": "text",
                  "settings": {
                    "text": "<p>No. The fabric is pet-hair resistant, not pet-hair proof. Its smoother, anti-static surface is designed to help reduce fur cling and make loose hair easier to brush away. Results vary.</p>",
