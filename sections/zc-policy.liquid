{% comment %} ZC Policy — shipping fit policy {% endcomment %}
<section class="zc-policy" id="zc-policy-{{ section.id }}" style="--zc-bg: {{ section.settings.bg_color }}; --zc-pad-top: {{ section.settings.padding_top }}px; --zc-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="zc-policy__inner">
    <div class="zc-policy__header">
      {% if section.settings.eyebrow != blank %}<p class="zc-kicker">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="zc-policy__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
    </div>
    <div class="zc-policy__grid">
      {% for block in section.blocks %}
        <article class="zc-policy__card" {{ block.shopify_attributes }}>
          {% if block.settings.number != blank %}<p class="zc-policy__num">{{ block.settings.number | escape }}</p>{% endif %}
          {% if block.settings.title != blank %}<h3 class="zc-policy__title">{{ block.settings.title | escape }}</h3>{% endif %}
          {% if block.settings.text != blank %}<p class="zc-policy__text">{{ block.settings.text | escape }}</p>{% endif %}
        </article>
      {% endfor %}
    </div>
    {% if section.settings.note != blank %}<p class="zc-policy__note">{{ section.settings.note | escape }}</p>{% endif %}
  </div>
</section>
{% stylesheet %}
  .zc-policy { background: var(--zc-bg, #faf7f2); padding: var(--zc-pad-top, 64px) 1.25rem var(--zc-pad-bottom, 64px); }
  .zc-policy__inner { max-width: 1100px; margin: 0 auto; }
  .zc-policy__header { text-align: center; margin-bottom: 2rem; }
  .zc-kicker { margin: 0 0 0.6rem; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: #8b6b4a; }
  .zc-policy__heading { margin: 0; font-size: clamp(1.4rem, 2vw, 1.85rem); color: #1c1917; }
  .zc-policy__grid { display: grid; gap: 1rem; }
  @media (min-width: 750px) { .zc-policy__grid { grid-template-columns: repeat(4, 1fr); gap: 1.25rem; } }
  .zc-policy__card { background: #fff; border-radius: 14px; padding: 1.25rem 1.1rem; border: 1px solid #e7e0d6; text-align: center; }
  .zc-policy__num { margin: 0 0 0.45rem; font-size: 0.8rem; letter-spacing: 0.08em; color: #8b6b4a; font-weight: 600; }
  .zc-policy__title { margin: 0 0 0.4rem; font-size: 1rem; color: #1c1917; }
  .zc-policy__text { margin: 0; color: #57534e; font-size: 0.9rem; line-height: 1.45; }
  .zc-policy__note { margin: 1.5rem 0 0; text-align: center; font-size: 0.85rem; color: #78716c; }
{% endstylesheet %}
{% schema %}
{
  "name": "ZC Policy",
  "tag": "section",
  "class": "zc-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FAF7F2" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SHIPPING, FIT & POLICY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for Your Pet. Ordered With Confidence." },
    { "type": "text", "id": "note", "label": "Note", "default": "Personalized preparation usually takes 6–10 days; shipping typically takes 7–15 days after dispatch. Estimates may vary." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [{
    "type": "item",
    "name": "Item",
    "settings": [
      { "type": "text", "id": "number", "label": "Number", "default": "01" },
      { "type": "text", "id": "title", "label": "Title", "default": "Your Photo Matters" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "A clear photo helps us capture the details you love." }
    ]
  }],
  "presets": [{
    "name": "ZC Policy",
    "blocks": [
      { "type": "item", "settings": { "number": "01", "title": "Your Photo Matters", "text": "A clear photo helps us capture the details you love." } },
      { "type": "item", "settings": { "number": "02", "title": "Choose Your Fit", "text": "Check the size guide before placing your personalized order." } },
      { "type": "item", "settings": { "number": "03", "title": "Free Shipping", "text": "Free shipping with clear delivery estimates at checkout." } },
      { "type": "item", "settings": { "number": "04", "title": "Clear Custom-Order Policies", "text": "Personalized items are made for you. Review our returns and replacement policy before ordering." } }
    ]
  }]
}
{% endschema %}
