{% comment %} Zena Comme — Fabric comparison side-by-side {% endcomment %}

<section class="zc-compare" id="zc-compare-{{ section.id }}" style="--zc-bg: {{ section.settings.bg_color }}; --zc-pad-top: {{ section.settings.padding_top }}px; --zc-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="zc-compare__inner">
    <div class="zc-compare__header">
      {% if section.settings.eyebrow != blank %}<p class="zc-kicker">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="zc-compare__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.body != blank %}<div class="zc-compare__intro">{{ section.settings.body }}</div>{% endif %}
    </div>
    <div class="zc-compare__grid">
      <figure class="zc-compare__col zc-compare__col--left">
        <div class="zc-compare__media">
          <span class="zc-compare__badge zc-compare__badge--left">{{ section.settings.label_left | default: 'Ordinary' | escape }}</span>
          {% if section.settings.image_left != blank %}
            {{ section.settings.image_left | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'zc-compare__img', alt: section.settings.label_left }}
          {% else %}
            <div class="zc-compare__ph zc-compare__ph--left">
              <strong>Ordinary cotton</strong>
              <span>Add a “fur cling” comparison photo</span>
            </div>
          {% endif %}
        </div>
        <figcaption>
          <strong>{{ section.settings.label_left | escape }}</strong>
          {% if section.settings.caption_left != blank %}<span>{{ section.settings.caption_left | escape }}</span>{% endif %}
        </figcaption>
      </figure>
      <figure class="zc-compare__col zc-compare__col--right">
        <div class="zc-compare__media">
          <span class="zc-compare__badge zc-compare__badge--right">{{ section.settings.label_right | default: 'Zena Comme' | escape }}</span>
          {% if section.settings.image_right != blank %}
            {{ section.settings.image_right | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'zc-compare__img', alt: section.settings.label_right }}
          {% else %}
            <div class="zc-compare__ph zc-compare__ph--right">
              <strong>Zena Comme</strong>
              <span>Add the smoother-fabric comparison photo</span>
            </div>
          {% endif %}
        </div>
        <figcaption>
          <strong>{{ section.settings.label_right | escape }}</strong>
          {% if section.settings.caption_right != blank %}<span>{{ section.settings.caption_right | escape }}</span>{% endif %}
        </figcaption>
      </figure>
    </div>
    {% if section.settings.note != blank %}
      <p class="zc-compare__note">{{ section.settings.note | escape }}</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .zc-compare {
    background: var(--zc-bg, #faf7f2);
    padding: var(--zc-pad-top, 64px) 1.25rem var(--zc-pad-bottom, 64px);
  }
  .zc-compare__inner { max-width: 1000px; margin: 0 auto; }
  .zc-compare__header { text-align: center; margin-bottom: 2rem; max-width: 720px; margin-inline: auto; }
  .zc-compare__heading {
    margin: 0 0 0.75rem;
    font-size: clamp(1.45rem, 2.1vw, 1.9rem);
    color: #1c1917;
  }
  .zc-compare__intro { color: #57534e; line-height: 1.55; }
  .zc-compare__intro p { margin: 0; }
  .zc-compare__grid {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 750px) {
    .zc-compare__grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  }
  .zc-compare__col { margin: 0; }
  .zc-compare__media {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #e7e0d6;
  }
  .zc-compare__col--right .zc-compare__media {
    border-color: #1c1917;
    box-shadow: 0 8px 24px rgba(28, 25, 23, 0.08);
  }
  .zc-compare__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 1;
    max-width: calc(100% - 1.5rem);
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .zc-compare__badge--left { background: #fff; color: #78716c; border: 1px solid #e7e0d6; }
  .zc-compare__badge--right { background: #1c1917; color: #fff; }
  .zc-compare__img, .zc-compare__ph {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .zc-compare__ph {
    background: #e8e0d4;
    display: grid;
    place-content: center;
    gap: 0.35rem;
    text-align: center;
    padding: 1rem;
    color: #7a6f63;
  }
  .zc-compare__ph--right { background: #f0ebe3; }
  .zc-compare__ph strong { color: #1c1917; font-size: 0.95rem; }
  .zc-compare__ph span { font-size: 0.82rem; line-height: 1.35; }
  .zc-compare__col figcaption {
    margin-top: 0.75rem;
    text-align: center;
    display: grid;
    gap: 0.25rem;
  }
  .zc-compare__col strong { color: #1c1917; }
  .zc-compare__col--right figcaption strong { color: #1c1917; }
  .zc-compare__col span { color: #fff; font-size: 0.92rem; }
  .zc-compare__note {
    margin: 1.5rem 0 0;
    text-align: center;
    font-size: 0.85rem;
    color: #78716c;
    font-style: italic;
  }
  .zc-kicker {
    margin: 0 0 0.6rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8b6b4a;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ZC Compare",
  "tag": "section",
  "class": "zc-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FAF7F2" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SEE THE DIFFERENCE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Same Pet Hair. Different Fabric. See for Yourself." },
    { "type": "richtext", "id": "body", "label": "Intro", "default": "<p>Pet hair clings to clothing because of texture, friction, and static. Our smoother, anti-static fabric is designed to help loose fur brush away more easily.</p>" },
    { "type": "image_picker", "id": "image_left", "label": "Left image (ordinary tee)" },
    { "type": "text", "id": "label_left", "label": "Left label", "default": "Ordinary Cotton Tee" },
    { "type": "text", "id": "caption_left", "label": "Left caption", "default": "Same Cuddles. More Fur Cling." },
    { "type": "image_picker", "id": "image_right", "label": "Right image (Zena Comme)" },
    { "type": "text", "id": "label_right", "label": "Right label", "default": "Zena Comme" },
    { "type": "text", "id": "caption_right", "label": "Right caption", "default": "Same Cuddles. Less Fur Cling." },
    { "type": "text", "id": "note", "label": "Footnote", "default": "Pet-hair resistant, not pet-hair proof. Results vary by pet type, contact, and care." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "presets": [{ "name": "ZC Compare" }]
}
{% endschema %}
