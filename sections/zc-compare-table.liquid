{% comment %} ZC Compare Table — editorial feature comparison {% endcomment %}
<section class="zc-ctable" id="zc-ctable-{{ section.id }}" style="--zc-bg: {{ section.settings.bg_color }}; --zc-pad-top: {{ section.settings.padding_top }}px; --zc-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="zc-ctable__inner">
    <div class="zc-ctable__header">
      {% if section.settings.eyebrow != blank %}<p class="zc-kicker">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="zc-ctable__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.body != blank %}<div class="zc-ctable__intro">{{ section.settings.body }}</div>{% endif %}
    </div>
    <div class="zc-ctable__wrap" role="table" aria-label="Feature comparison">
      <div class="zc-ctable__row zc-ctable__row--head" role="row">
        <div class="zc-ctable__cell zc-ctable__cell--feature" role="columnheader">{{ section.settings.col_feature | default: 'Features' | escape }}</div>
        <div class="zc-ctable__cell zc-ctable__cell--us" role="columnheader">{{ section.settings.col_us | default: 'Zena Comme' | escape }}</div>
        <div class="zc-ctable__cell zc-ctable__cell--them" role="columnheader">{{ section.settings.col_them | default: 'Other Custom Tees' | escape }}</div>
      </div>
      {% for block in section.blocks %}
        <div class="zc-ctable__row" role="row" {{ block.shopify_attributes }}>
          <div class="zc-ctable__cell zc-ctable__cell--feature" role="cell"><strong>{{ block.settings.feature | escape }}</strong></div>
          <div class="zc-ctable__cell zc-ctable__cell--us" role="cell">{{ block.settings.us | escape }}</div>
          <div class="zc-ctable__cell zc-ctable__cell--them" role="cell">{{ block.settings.them | escape }}</div>
        </div>
      {% endfor %}
    </div>
    {% if section.settings.footer != blank %}<p class="zc-ctable__footer">{{ section.settings.footer | escape }}</p>{% endif %}
    {% if section.settings.button_label != blank %}
      <div class="zc-ctable__cta">
        <a class="zc-btn zc-btn--inline" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
      </div>
    {% endif %}
  </div>
</section>
{% stylesheet %}
  .zc-ctable { background: var(--zc-bg, #f5f0e8); padding: var(--zc-pad-top, 64px) 1.25rem var(--zc-pad-bottom, 64px); }
  .zc-ctable__inner { max-width: 900px; margin: 0 auto; }
  .zc-ctable__header { text-align: center; margin-bottom: 1.75rem; }
  .zc-kicker { margin: 0 0 0.6rem; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: #8b6b4a; }
  .zc-ctable__heading { margin: 0 0 0.6rem; font-size: clamp(1.4rem, 2vw, 1.85rem); color: #1c1917; }
  .zc-ctable__intro { color: #57534e; line-height: 1.55; }
  .zc-ctable__intro p { margin: 0; }
  .zc-ctable__wrap { border-radius: 12px; overflow: hidden; border: 1px solid #e7e0d6; background: #fff; }
  .zc-ctable__row { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 0; }
  .zc-ctable__cell { padding: 0.9rem 1rem; border-top: 1px solid #ece7df; font-size: 0.92rem; color: #44403c; }
  .zc-ctable__row--head .zc-ctable__cell { background: #1c1917; color: #fff; border-top: 0; font-weight: 600; font-size: 0.85rem; }
  /* Positive "us" column — sage/brand, never red */
  .zc-ctable__row:not(.zc-ctable__row--head) .zc-ctable__cell--us {
    color: #3f6b4a;
    font-weight: 600;
    background: #f4f7f2;
  }
  .zc-ctable__row:not(.zc-ctable__row--head) .zc-ctable__cell--them {
    color: #78716c;
  }
  .zc-ctable__footer { margin: 1rem 0 0; text-align: center; font-style: italic; color: #57534e; }
  .zc-ctable__cta { text-align: center; margin-top: 1.5rem; }
  .zc-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0.85rem 1.5rem; border-radius: 999px; background: #1c1917; color: #fff !important; text-decoration: none !important; font-weight: 600; }
  .zc-btn--inline { width: auto; }
  @media (max-width: 600px) {
    .zc-ctable__row { grid-template-columns: 1fr; }
    .zc-ctable__cell--feature { background: #faf7f2; font-weight: 600; }
    .zc-ctable__row--head { display: none; }
    .zc-ctable__row:not(.zc-ctable__row--head) .zc-ctable__cell--us::before {
      content: attr(data-label);
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "ZC Compare Table",
  "tag": "section",
  "class": "zc-section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F5F0E8" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "AN EDITORIAL COMPARISON" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not All Custom Pet Tees Are Made for Pet Parents." },
    { "type": "richtext", "id": "body", "label": "Intro", "default": "<p>Most personalized tees start with “What should we print on it?” We asked one more question: What happens when you wear it around your pet?</p>" },
    { "type": "text", "id": "col_feature", "label": "Column: Feature", "default": "Features" },
    { "type": "text", "id": "col_us", "label": "Column: Us", "default": "Zena Comme" },
    { "type": "text", "id": "col_them", "label": "Column: Others", "default": "Other Custom Tees" },
    { "type": "text", "id": "footer", "label": "Footer", "default": "A personalized tee that considers the pet hair, too." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Choose My Tee" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "blocks": [{
    "type": "row",
    "name": "Row",
    "settings": [
      { "type": "text", "id": "feature", "label": "Feature", "default": "Personalized pet image" },
      { "type": "text", "id": "us", "label": "Zena Comme", "default": "Yes" },
      { "type": "text", "id": "them", "label": "Others", "default": "Common" }
    ]
  }],
  "presets": [{
    "name": "ZC Compare Table",
    "blocks": [
      { "type": "row", "settings": { "feature": "Personalized pet image", "us": "Yes", "them": "Common" } },
      { "type": "row", "settings": { "feature": "Smooth pet-hair resistant fabric", "us": "Designed for this", "them": "Depends on garment" } },
      { "type": "row", "settings": { "feature": "Anti-static fabric design", "us": "Specified feature", "them": "Varies" } },
      { "type": "row", "settings": { "feature": "Front or back placement", "us": "Yes", "them": "Varies" } },
      { "type": "row", "settings": { "feature": "Everyday pet-home focus", "us": "Core priority", "them": "Varies" } }
    ]
  }]
}
{% endschema %}
